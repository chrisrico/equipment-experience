<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>WeaponExperience</AssemblyName>
    <RootNamespace>WeaponExperience</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.0</Version>
    <Description>Replaces the random Forge of Potential idol upgrades with item experience. Max-level weapons, tools, shields and armor gain experience as you use them, and a full bar guarantees the upgrade.</Description>
    <!-- Unity ships older System.* facades than netstandard2.1; the conflicts are harmless. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Thunderstore package metadata. Version and Description above are reused for the manifest. -->
  <PropertyGroup>
    <ThunderstoreName>WeaponExperience</ThunderstoreName>
    <ThunderstoreWebsite>https://github.com/chrisrico/weapon-experience</ThunderstoreWebsite>
    <ThunderstoreDependencies>&quot;denikson-BepInExPack_Valheim-5.4.2351&quot;</ThunderstoreDependencies>
  </PropertyGroup>

  <!-- Override on the command line: dotnet build -p:ValheimDir=/path/to/Valheim -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == '' And Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim')">$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' And Exists('$(HOME)/.steam/steam/steamapps/common/Valheim')">$(HOME)/.steam/steam/steamapps/common/Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir Condition="Exists('$(ValheimDir)/valheim.app/Contents/Resources/Data/Managed')">$(ValheimDir)/valheim.app/Contents/Resources/Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir>$(ValheimDir)/BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)/assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exposes the project Version to code so the plugin version has a single source. -->
  <Target Name="GeneratePluginInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginInfoFile>$(IntermediateOutputPath)PluginInfo.g.cs</PluginInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace WeaponExperience { internal static class PluginInfo { public const string Version = &quot;$(Version)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(PluginInfoFile)" />
      <FileWrites Include="$(PluginInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- dotnet build -c Release -p:Package=true writes dist/WeaponExperience-<version>.zip for Thunderstore upload. -->
  <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Package)' == 'true'">
    <PropertyGroup>
      <PackageStage>$(BaseIntermediateOutputPath)thunderstore/</PackageStage>
      <PackageZip>$(MSBuildProjectDirectory)/dist/$(ThunderstoreName)-$(Version).zip</PackageZip>
    </PropertyGroup>
    <ItemGroup>
      <ManifestLine Include="{" />
      <ManifestLine Include="  &quot;name&quot;: &quot;$(ThunderstoreName)&quot;," />
      <ManifestLine Include="  &quot;version_number&quot;: &quot;$(Version)&quot;," />
      <ManifestLine Include="  &quot;website_url&quot;: &quot;$(ThunderstoreWebsite)&quot;," />
      <ManifestLine Include="  &quot;description&quot;: &quot;$(Description)&quot;," />
      <ManifestLine Include="  &quot;dependencies&quot;: [$(ThunderstoreDependencies)]" />
      <ManifestLine Include="}" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStage)" />
    <Copy SourceFiles="README.md;CHANGELOG.md;thunderstore/icon.png" DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStage)plugins" />
    <WriteLinesToFile File="$(PackageStage)manifest.json" Lines="@(ManifestLine)" Overwrite="true" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/dist" />
    <ZipDirectory SourceDirectory="$(PackageStage)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Thunderstore package: $(PackageZip)" />
  </Target>

  <!-- dotnet build -p:Deploy=true copies the plugin into the local BepInEx plugins folder. -->
  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <MakeDir Directories="$(BepInExDir)/plugins/WeaponExperience" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)/plugins/WeaponExperience" />
  </Target>

</Project>
