<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks every game member the mod relies on against an installed Valheim, without starting the game.
    Run after a game update:  dotnet run -project tools/GameApiCheck [path/to/Valheim]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx's bundled Harmony doesn't run on .NET 8; HarmonyX's reflection helpers do. -->
    <PackageReference Include="HarmonyX" Version="2.14.0" />
    <ProjectReference Include="../../EquipmentExperience.csproj" />
  </ItemGroup>

</Project>
